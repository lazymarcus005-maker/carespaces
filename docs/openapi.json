  "info": {
    "title": "Carespaces API",
    "description": "Carespaces MVP REST API",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status", "service", "timestamp"],
        "properties": {
          "status": {
            "type": "string",
            "enum": ["ok"]
          },
          "service": {
            "type": "string",
            "enum": ["api"]
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "CreateFamilyTenantRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["displayName"],
        "properties": {
          "displayName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        }
      },
      "FamilyTenantResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["userId", "tenant", "membership"],
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "tenant": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "type", "status", "displayName"],
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "type": {
                "type": "string",
                "enum": ["FAMILY"]
              },
              "status": {
                "type": "string",
                "enum": ["ACTIVE"]
              },
              "displayName": {
                "type": "string"
              }
            }
          },
          "membership": {
            "type": "object",
            "additionalProperties": false,
            "required": ["status", "role"],
            "properties": {
              "status": {
                "type": "string",
                "enum": ["ACTIVE"]
              },
              "role": {
                "type": "string",
                "enum": ["FAMILY_OWNER"]
              }
            }
          }
        }
      },
      "OpsTask": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "tenantId",
          "taskType",
          "subjectType",
          "subjectId",
          "queue",
          "priority",
          "ownerUserId",
          "dueAt",
          "escalationLevel",
          "status",
          "resolutionCode",
          "version",
          "createdAt",
          "updatedAt",
          "resolvedAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "tenantId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "taskType": {
            "type": "string"
          },
          "subjectType": {
            "type": "string"
          },
          "subjectId": {
            "type": "string",
            "format": "uuid"
          },
          "queue": {
            "type": "string",
            "enum": [
              "VERIFICATION",
              "CLINICAL",
              "URGENT",
              "INCIDENT",
              "REPLACEMENT",
              "DISPUTE",
              "FINANCE",
              "GENERAL"
            ]
          },
          "priority": {
            "type": "string",
            "enum": ["LOW", "NORMAL", "HIGH", "CRITICAL"]
          },
          "ownerUserId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "dueAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "escalationLevel": {
            "type": "integer",
            "minimum": 0
          },
          "status": {
            "type": "string",
            "enum": ["OPEN", "CLAIMED", "RESOLVED", "CANCELLED"]
          },
          "resolutionCode": {
            "type": "string",
            "nullable": true
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "resolvedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        }
      },
      "OpsTaskListResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["actor", "tasks", "generatedAt"],
        "properties": {
          "actor": {
            "type": "object",
            "additionalProperties": false,
            "required": ["userId", "roles", "queues"],
            "properties": {
              "userId": {
                "type": "string",
                "format": "uuid"
              },
              "roles": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "queues": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "VERIFICATION",
                    "CLINICAL",
                    "URGENT",
                    "INCIDENT",
                    "REPLACEMENT",
                    "DISPUTE",
                    "FINANCE",
                    "GENERAL"
                  ]
                }
              }
            }
          },
          "tasks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OpsTask"
            }
          },
          "generatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "OpsTaskCommand": {
        "type": "object",
        "additionalProperties": false,
        "required": ["expectedVersion", "reasonCode"],
        "properties": {
          "expectedVersion": {
            "type": "integer",
            "minimum": 1
          },
          "reasonCode": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{2,100}$"
          }
        }
      },
      "ReassignOpsTaskRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["expectedVersion", "reasonCode", "newOwnerUserId"],
        "properties": {
          "expectedVersion": {
            "type": "integer",
            "minimum": 1
          },
          "reasonCode": {
            "type": "string"
          },
          "newOwnerUserId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "EscalateOpsTaskRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["expectedVersion", "reasonCode"],
        "properties": {
          "expectedVersion": {
            "type": "integer",
            "minimum": 1
          },
          "reasonCode": {
            "type": "string"
          },
          "priority": {
            "type": "string",
            "enum": ["LOW", "NORMAL", "HIGH", "CRITICAL"]
          },
          "dueAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ResolveOpsTaskRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["expectedVersion", "reasonCode", "resolutionCode"],
        "properties": {
          "expectedVersion": {
            "type": "integer",
            "minimum": 1
          },
          "reasonCode": {
            "type": "string"
          },
          "resolutionCode": {
            "type": "string"
          }
        }
      },
      "NotificationIntent": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "tenantId",
          "notificationClass",
          "channel",
          "subjectType",
          "subjectId",
          "recipientUserId",
          "recipientRef",
          "bodyRedacted",
          "correlationId",
          "status",
          "attempts",
          "nextAttemptAt",
          "deliveredAt",
          "terminalFailedAt",
          "lastError",
          "acknowledgedAt",
          "opsTaskId",
          "version",
          "createdAt",
          "updatedAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "tenantId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "notificationClass": {
            "type": "string",
            "enum": [
              "incident_ack",
              "sos",
              "credential_expiry_block",
              "replacement_failed",
              "shift_reminder",
              "reservation_expiry",
              "payment_expiry",
              "customer_approval_reminder",
              "dispute_update",
              "payout_retry",
              "system"
            ]
          },
          "channel": {
            "type": "string",
            "enum": ["push", "sms", "email", "in_app"]
          },
          "subjectType": {
            "type": "string"
          },
          "subjectId": {
            "type": "string",
            "format": "uuid"
          },
          "recipientUserId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "recipientRef": {
            "type": "string"
          },
          "bodyRedacted": {
            "type": "string"
          },
          "correlationId": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "PENDING",
              "LEASED",
              "DELIVERED",
              "TERMINAL_FAILED",
              "CANCELLED"
            ]
          },
          "attempts": {
            "type": "integer",
            "minimum": 0
          },
          "nextAttemptAt": {
            "type": "string",
            "format": "date-time"
          },
          "deliveredAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "terminalFailedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "lastError": {
            "type": "string",
            "nullable": true
          },
          "acknowledgedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "opsTaskId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "NotificationAttempt": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "intentId",
          "attemptNumber",
          "channel",
          "adapterName",
          "status",
          "providerMessageRef",
          "errorClass",
          "errorMessage",
          "startedAt",
          "completedAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "intentId": {
            "type": "string",
            "format": "uuid"
          },
          "attemptNumber": {
            "type": "integer",
            "minimum": 1
          },
          "channel": {
            "type": "string",
            "enum": ["push", "sms", "email", "in_app"]
          },
          "adapterName": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": ["FIRED", "FAILED", "DEAD_LETTER"]
          },
          "providerMessageRef": {
            "type": "string",
            "nullable": true
          },
          "errorClass": {
            "type": "string",
            "nullable": true
          },
          "errorMessage": {
            "type": "string",
            "nullable": true
          },
          "startedAt": {
            "type": "string",
            "format": "date-time"
          },
          "completedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        }
      },
      "NotificationIntentListResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["intents", "generatedAt"],
        "properties": {
          "intents": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/NotificationIntent"
            }
          },
          "generatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "NotificationAttemptListResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["intentId", "attempts", "generatedAt"],
        "properties": {
          "intentId": {
            "type": "string",
            "format": "uuid"
          },
          "attempts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/NotificationAttempt"
            }
          },
          "generatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["error"],
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "message", "requestId", "status"],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "requestId": {
                "type": "string"
              },
              "status": {
                "type": "integer",
                "minimum": 400,
                "maximum": 599
              }
            }
          }
        }
      }
    }
  }
}
