{
  "name": "carespaces",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "api:generate": "tsx --tsconfig apps/api/tsconfig.json apps/api/scripts/generate-openapi.ts && openapi-typescript docs/openapi.json -o packages/api-contracts/src/generated/openapi.ts && prettier --write docs/openapi.json packages/api-contracts/src/generated/openapi.ts",
    "api:check": "pnpm api:generate && prettier --check docs/openapi.json packages/api-contracts/src/generated/openapi.ts && git diff --exit-code -- docs/openapi.json packages/api-contracts/src/generated/openapi.ts",
    "build": "turbo run build",
    "db:down": "docker compose -f infrastructure/database/compose.yaml down",
    "db:generate": "node node_modules/prisma/build/index.js generate --config spikes/orm/prisma.config.ts",
    "db:migrate": "tsx packages/database/src/cli.ts up",
    "db:rollback": "tsx packages/database/src/cli.ts down",
    "db:seed": "tsx packages/database/src/cli.ts seed",
    "db:spike": "tsx spikes/orm/run.ts",
    "db:status": "tsx packages/database/src/cli.ts status",
    "db:up": "docker compose -f infrastructure/database/compose.yaml up -d --wait",
    "db:verify": "tsx packages/database/test/verify.ts",
    "dev": "turbo run dev --parallel",
    "data:ingest": "tsx scripts/ingest-local-data.ts",
    "dev:all": "tsx scripts/run-all-services.ts",
    "config:status": "pnpm --filter @carespaces/worker config:status",
    "config:verify": "tsx --tsconfig apps/worker/tsconfig.json apps/worker/test/config.integration.ts",
    "deadline:status": "pnpm --filter @carespaces/worker deadline:status",
    "deadline:verify": "tsx --tsconfig apps/worker/tsconfig.json apps/worker/test/deadline.integration.ts",
    "event:replay": "pnpm --filter @carespaces/worker replay --",
    "event:verify": "tsx --tsconfig apps/worker/tsconfig.json apps/worker/test/eventing.integration.ts",
    "format": "prettier --write \"{apps,packages,spikes,scripts}/**/*.{ts,tsx,css,json,mjs}\" \"{infrastructure,.github}/**/*.{yaml,yml}\" \"*.{json,mjs,yaml}\"",
    "format:check": "prettier --check \"{apps,packages,spikes,scripts}/**/*.{ts,tsx,css,json,mjs}\" \"{infrastructure,.github}/**/*.{yaml,yml}\" \"*.{json,mjs,yaml}\"",
    "iam:verify": "tsx --tsconfig apps/api/tsconfig.json apps/api/test/identity.integration.ts",
    "ops-task:status": "pnpm --filter @carespaces/worker ops-task:status",
    "ops-task:verify": "tsx --tsconfig apps/worker/tsconfig.json apps/worker/test/ops-task.integration.ts",
    "ops-api:verify": "tsx --tsconfig apps/api/tsconfig.json apps/api/test/operations.integration.ts",
    "lint": "turbo run lint && eslint spikes/**/*.ts scripts/**/*.ts",
    "test": "turbo run test",
    "test:integration": "pnpm db:verify && pnpm iam:verify && pnpm event:verify && pnpm deadline:verify && pnpm config:verify && pnpm ops-task:verify && pnpm ops-api:verify",
    "typecheck": "turbo run typecheck && pnpm db:generate && tsc -p spikes/orm/tsconfig.json --noEmit && tsc -p scripts/tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@prisma/adapter-pg": "7.8.0",
    "@prisma/client": "7.8.0",
    "@types/node": "^22.20.1",
    "@types/pg": "^8.15.6",
    "drizzle-orm": "0.45.2",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "openapi-typescript": "7.13.0",
    "pg": "^8.16.3",
    "postgres": "3.4.9",
    "prettier": "^3.7.4",
    "prisma": "7.8.0",
    "tsx": "^4.21.0",
    "turbo": "2.10.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.1"
  }
}
